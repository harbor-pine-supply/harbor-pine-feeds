{
  "permissions": {
    "deny": [
      "Edit(/data/**)",
      "Edit(/scripts/**)",
      "Edit(/approvals/**)",
      "Edit(/outbox/**)",
      "Edit(/.claude/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/policy-gate.mjs"],
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}
